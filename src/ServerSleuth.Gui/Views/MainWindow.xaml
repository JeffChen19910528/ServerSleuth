<Window x:Class="ServerSleuth.Gui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:ServerSleuth.Gui.ViewModels"
        xmlns:results="clr-namespace:ServerSleuth.Gui.ViewModels.Results"
        xmlns:views="clr-namespace:ServerSleuth.Gui.Views"
        Title="{Binding ApplicationTitle}"
        Height="720" Width="1180" MinHeight="480" MinWidth="800"
        Background="{StaticResource App.Background}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:PlaceholderPageViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ScanConfigurationViewModel}">
            <views:ScanConfigurationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ScanExecutionViewModel}">
            <views:ScanExecutionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type results:ResultsDashboardViewModel}">
            <views:ResultsDashboardView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Application title bar -->
        <Border Grid.Row="0" Background="{StaticResource App.HeaderBackground}" Padding="{StaticResource Spacing.Medium}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ApplicationTitle}" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{Binding VersionText}" Style="{StaticResource Text.Muted}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left navigation -->
            <Border Grid.Column="0" Background="{StaticResource App.NavBackground}">
                <ItemsControl ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:NavigationItemViewModel}">
                            <Button Content="{Binding Label}"
                                    Style="{StaticResource NavigationItem}"
                                    Tag="{Binding IsSelected}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Page}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Main content region -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPageViewModel}" Margin="{StaticResource Spacing.Large}" />
        </Grid>

        <!-- Status/footer area -->
        <Border Grid.Row="2" Background="{StaticResource App.FooterBackground}" Padding="{StaticResource Spacing.Small}">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Muted}" />
        </Border>
    </Grid>
</Window>
