<UserControl x:Class="ServerSleuth.Gui.Views.InventoryExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:results="clr-namespace:ServerSleuth.Gui.ViewModels.Results"
             xmlns:views="clr-namespace:ServerSleuth.Gui.Views">

    <!-- GUI-6A originally, promoted to a standalone reusable View in GUI-7A: DataContext is
         always an InventoryExplorerViewModel directly — whether this is hosted as
         ResultsDashboardView's embedded "Discovery Inventory" section (DataContext="{Binding
         Inventory}") or as MainViewModel's own first-class Inventory navigation page. Same
         ViewModel type, same View, in both places — no second inventory engine, no duplicated
         markup. -->
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type results:InventoryDetailViewModel}">
            <views:InventoryDetailView />
        </DataTemplate>
    </UserControl.Resources>

    <!-- GUI-7C: wrapped in its own ScrollViewer — when this View is MainViewModel's standalone
         Inventory page, MainWindow's own content ContentControl has none of its own (every other
         top-level page provides its own), so without this, a tall detail panel (long
         Evidence/Metadata lists) on a shorter window would be clipped with no way to reach it.
         Harmless when embedded inside ResultsDashboardView's own outer ScrollViewer too — nested
         ScrollViewers are a standard, well-tolerated WPF pattern (the inner one only captures
         scroll input once its own content actually overflows). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
        <Border Style="{StaticResource Dashboard.Card}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Dashboard.Inventory}" Style="{StaticResource Dashboard.SectionTitle}" />

                <TextBlock Text="{DynamicResource Dashboard.InventoryPartialCoverage}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                           Visibility="{Binding HasPartialCoverage, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ComboBox Width="200" Margin="0,0,8,0"
                              ToolTip="{DynamicResource Dashboard.InventoryCategoryTooltip}"
                              ItemsSource="{Binding CategoryFilterOptions}"
                              SelectedItem="{Binding SelectedCategory}" />
                    <TextBox Width="240" Margin="0,0,8,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource Dashboard.InventorySearchTooltip}" />
                    <!-- Plain TextBlock.Text bindings, never Run-hosted (GUI-7C binding-safety
                         sweep): this View is also shown as MainViewModel's standalone Inventory
                         page, rebuilt FRESH on every navigation — the same "freshly re-attached
                         to layout" scenario that made a Run-hosted binding on Dashboard throw
                         InvalidOperationException in GUI-7A (see DashboardView.xaml's own
                         comment). Safe here as embedded Results content too (where the instance
                         is cached, not rebuilt), matching the convention every other GUI-7A/7B
                         page already follows. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Dashboard.InventoryCountLabel}" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding FilteredItems.Count}" Style="{StaticResource Text.Muted}" />
                    </StackPanel>
                </StackPanel>

                <!-- Category counts (skill.md GUI-6A §6) -->
                <ItemsControl ItemsSource="{Binding Categories}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type results:InventoryCategoryViewModel}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                <TextBlock Text="{Binding Type}" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" />
                                <TextBlock Text=": " Style="{StaticResource Text.Muted}" />
                                <TextBlock Text="{Binding Count}" Style="{StaticResource Text.Muted}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{DynamicResource Dashboard.NoInventory}" Style="{StaticResource Text.Muted}"
                           Visibility="{Binding HasNoInventory, Converter={StaticResource BoolToVisibility}}" />

                <ListView ItemsSource="{Binding FilteredItems}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          MaxHeight="320"
                          Visibility="{Binding HasNoInventory, Converter={StaticResource InverseBoolToVisibility}}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{DynamicResource Dashboard.ColType}" Width="140" DisplayMemberBinding="{Binding Type}" />
                            <GridViewColumn Header="{DynamicResource Dashboard.ColName}" Width="220" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="{DynamicResource Dashboard.ColStatus}" Width="90" DisplayMemberBinding="{Binding Status}" />
                            <GridViewColumn Header="{DynamicResource Dashboard.ColVersion}" Width="90" DisplayMemberBinding="{Binding Version}" />
                            <GridViewColumn Header="{DynamicResource Dashboard.ColArchitecture}" Width="90" DisplayMemberBinding="{Binding Architecture}" />
                            <GridViewColumn Header="{DynamicResource Dashboard.ColOwnerApplication}" Width="160" DisplayMemberBinding="{Binding ApplicationDisplay}" />
                            <GridViewColumn Header="{DynamicResource Dashboard.ColEvidenceCount}" Width="70" DisplayMemberBinding="{Binding EvidenceCount}" />
                            <GridViewColumn Header="{DynamicResource Dashboard.ColPath}" Width="260" DisplayMemberBinding="{Binding Path}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </Border>

        <!-- SELECTED INVENTORY ITEM DETAIL — a null Content renders nothing. -->
        <ContentControl Content="{Binding SelectedDetail}" Margin="0,16,0,0" />
    </StackPanel>
    </ScrollViewer>
</UserControl>
