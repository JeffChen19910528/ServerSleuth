<UserControl x:Class="ServerSleuth.Gui.Views.ScanExecutionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ServerSleuth.Gui.Models;assembly=ServerSleuth.Gui.Contracts">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource ScanExec.Title}" Style="{StaticResource Text.PageTitle}" />

            <TextBlock Style="{StaticResource Text.Body}" Margin="0,16,0,0">
                <Run Text="{DynamicResource ScanExec.TargetLabel}" FontWeight="SemiBold" />
                <Run Text="{Binding State.TargetDisplayName, Mode=OneWay}" />
                <Run Text=" (" />
                <Run Text="{Binding State.TargetPlatform, Mode=OneWay}" />
                <Run Text=")" />
            </TextBlock>

            <TextBlock Text="{DynamicResource ScanExec.CurrentStage}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,16,0,4" />
            <TextBlock Text="{Binding State.CurrentStage, Mode=OneWay}" Style="{StaticResource Text.Title}" />

            <!-- Discovery scanner detail — only meaningful once at least one scanner has reported. -->
            <ItemsControl ItemsSource="{Binding State.ScannerStatuses, Mode=OneWay}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ScannerProgressInfo}">
                        <TextBlock Style="{StaticResource Text.Muted}">
                            <Run Text="{Binding ScannerId, Mode=OneWay}" />
                            <Run Text=" — " />
                            <Run Text="{Binding Status, Mode=OneWay}" />
                            <Run Text=" (" />
                            <Run Text="{Binding EntityCount, Mode=OneWay}" />
                            <Run Text="{DynamicResource ScanExec.EntitiesSuffix}" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Text.Body}" Margin="0,12,0,0">
                <Run Text="{DynamicResource ScanExec.EntitiesDiscoveredLabel}" FontWeight="SemiBold" />
                <Run Text="{Binding State.EntityCount, Mode=OneWay}" />
            </TextBlock>

            <!-- No real percentage exists anywhere in the underlying pipeline — an indeterminate
                 bar while running, never a fabricated number (skill.md GUI-3 §6). -->
            <ProgressBar Height="6" Margin="0,12,0,0" IsIndeterminate="True"
                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />

            <!-- Completion summary -->
            <StackPanel Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                <TextBlock Text="{DynamicResource ScanExec.ScanCompleted}" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0">
                    <Run Text="{DynamicResource ScanExec.StatusLabel}" FontWeight="SemiBold" />
                    <Run Text="{Binding State.Status, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource Text.Body}">
                    <Run Text="{DynamicResource ScanExec.ErrorsLabel}" FontWeight="SemiBold" />
                    <Run Text="{Binding State.ErrorCount, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding State.ErrorMessage, Mode=OneWay}" Foreground="{StaticResource Risk.High}"
                           Visibility="{Binding HasErrorMessage, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource ScanExec.ReportsLabel}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ItemsControl ItemsSource="{Binding State.OutputPaths, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Muted}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="{DynamicResource ScanExec.CancelScan}" Style="{StaticResource App.Button}" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <!-- GUI-4 §Step4: "View Results" opens the Results Dashboard; "New Scan" (labelled
                     "Start New Scan" here) returns to Scan Configuration — the two buttons the
                     completion UI is required to offer, both routed through MainViewModel. -->
                <Button Content="{DynamicResource ScanExec.ViewResults}" Style="{StaticResource App.Button}" Command="{Binding ViewResultsCommand}" Margin="0,0,8,0" />
                <Button Content="{DynamicResource ScanExec.StartNewScan}" Style="{StaticResource App.Button}" Command="{Binding NewScanCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
