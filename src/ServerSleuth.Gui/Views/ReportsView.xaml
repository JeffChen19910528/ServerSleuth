<UserControl x:Class="ServerSleuth.Gui.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:results="clr-namespace:ServerSleuth.Gui.ViewModels.Results">

    <!-- GUI-7B: a lightweight view over the latest completed scan's already-written report
         files, reusing ReportsOverviewViewModel's Export/Viewer commands — which themselves only
         ever call IGuiReportExportService/IGuiReportViewerService (the SAME services GUI-5's
         Results Dashboard already uses). No second export implementation, no re-render, no
         WebView2/embedded browser — JSON/HTML are shown as plain text, exactly like Results. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource Reports.Title}" Style="{StaticResource Text.PageTitle}" />

            <!-- EMPTY STATE — no report has been written yet. Never a fabricated report entry. -->
            <StackPanel Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                <Border Style="{StaticResource Dashboard.Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Reports.NoResultsTitle}" Style="{StaticResource Dashboard.SectionTitle}" />
                        <TextBlock Text="{DynamicResource Reports.NoResultsBody}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <Button Content="{DynamicResource ScanConfig.StartScan}" Command="{Binding StartScanCommand}"
                                Style="{StaticResource App.Button}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- POPULATED STATE -->
            <StackPanel Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">

                <!-- LATEST SCAN -->
                <Border Style="{StaticResource Dashboard.Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Overview.LastScan}" Style="{StaticResource Dashboard.SectionTitle}" />
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                                <TextBlock Text="{DynamicResource Dashboard.TargetLabel}" FontWeight="SemiBold" Style="{StaticResource Text.Body}" />
                                <TextBlock Text="{Binding TargetDisplayName}" Style="{StaticResource Text.Body}" />
                                <TextBlock Text=" (" Style="{StaticResource Text.Body}" />
                                <TextBlock Text="{Binding TargetPlatform}" Style="{StaticResource Text.Body}" />
                                <TextBlock Text=")" Style="{StaticResource Text.Body}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                                <TextBlock Text="{DynamicResource Dashboard.FinishedLabel}" FontWeight="SemiBold" Style="{StaticResource Text.Body}" />
                                <TextBlock Text="{Binding FinishedAt}" Style="{StaticResource Text.Body}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                                <TextBlock Text="{DynamicResource Dashboard.StatusLabel}" FontWeight="SemiBold" Style="{StaticResource Text.Body}" />
                                <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Body}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- AVAILABLE REPORTS / REPORT VIEWER — an already-generated file's raw text
                     only; never a re-render, never a second domain deserialization. -->
                <Border Style="{StaticResource Dashboard.Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Reports.Available}" Style="{StaticResource Dashboard.SectionTitle}" />
                        <TextBlock Text="{DynamicResource Dashboard.NoReportFiles}" Style="{StaticResource Text.Muted}"
                                   Visibility="{Binding ReportFileNames.Count, Converter={StaticResource CountToInverseVisibility}}" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding ReportFileNames.Count, Converter={StaticResource CountToVisibility}}">
                            <ComboBox Width="180" Margin="0,0,8,0" ItemsSource="{Binding ReportFileNames}" SelectedItem="{Binding SelectedReportFileName}" />
                            <Button Content="{DynamicResource Dashboard.OpenReport}" Command="{Binding OpenReportCommand}" Style="{StaticResource App.Button}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ReportViewResult.ErrorMessage}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0"
                                   Visibility="{Binding ReportViewResult.Success, Converter={StaticResource InverseBoolToVisibility}, FallbackValue=Collapsed}" />
                        <!-- Plain text only — no WebView2/embedded browser, no HTML rendering, no
                             JavaScript execution, whether the selected file is .json or .html. -->
                        <TextBox Text="{Binding ReportViewResult.Content, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap"
                                  FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  MaxHeight="320" Margin="0,4,0,0"
                                  Visibility="{Binding ReportViewResult.Success, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                    </StackPanel>
                </Border>

                <!-- EXPORT REPORT -->
                <Border Style="{StaticResource Dashboard.Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard.ExportReport}" Style="{StaticResource Dashboard.SectionTitle}" />
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="{DynamicResource Dashboard.Format}" Style="{StaticResource Text.Muted}" />
                                <ComboBox Width="120" ItemsSource="{Binding Source={x:Static results:ResultsDashboardViewModel.ExportFormatOptions}}"
                                          SelectedItem="{Binding ExportFormat}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="{DynamicResource Dashboard.IfFileExists}" Style="{StaticResource Text.Muted}" />
                                <ComboBox Width="160" ItemsSource="{Binding Source={x:Static results:ResultsDashboardViewModel.OverwritePolicyOptions}}"
                                          SelectedItem="{Binding ExportOverwritePolicy}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="{DynamicResource Dashboard.OutputDirectory}" Style="{StaticResource Text.Muted}" />
                                <TextBox Width="320" Text="{Binding ExportDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>
                        <Button Content="{DynamicResource Dashboard.ExportReport}" Command="{Binding ExportReportCommand}"
                                Style="{StaticResource App.Button}" HorizontalAlignment="Left" />
                        <!-- Two plain TextBlocks instead of sibling Run elements — see
                             DashboardView.xaml's own comment: a Run-hosted binding on a
                             ViewModel instance rebuilt fresh on every navigation (this page's own
                             contract) can throw the same read-only-property InvalidOperationException
                             a Run-hosted binding on Dashboard already did. -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                    Visibility="{Binding LastExportResult.Success, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                            <TextBlock Text="{DynamicResource Dashboard.ExportedLabel}" FontWeight="SemiBold" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LastExportedFileNamesText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{Binding LastExportResult.ErrorMessage}" Style="{StaticResource Text.Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding LastExportResult.Success, Converter={StaticResource InverseBoolToVisibility}, FallbackValue=Collapsed}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
