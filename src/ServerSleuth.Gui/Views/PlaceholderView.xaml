<UserControl x:Class="ServerSleuth.Gui.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Top">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" Margin="0,8,0,0" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
