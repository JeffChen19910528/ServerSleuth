<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:res="clr-namespace:ServerSleuth.Gui.Resources">

    <!-- GUI-1 §7 (Theme/Resources): a minimal, consistent visual foundation only — no actual
         dashboard/chart/report styling is implemented yet (that belongs to a later GUI phase
         once the pages it decorates exist). -->

    <!-- GUI-2: value converters used by ScanConfigurationView. BooleanToVisibilityConverter is
         a built-in WPF type — no custom equivalent was written for it. -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <res:OverwritePolicyToBoolConverter x:Key="OverwriteToBoolConverter" />

    <!-- GUI-4: risk severity brush converters — RiskSeverityBrushConverter existed since GUI-1
         but was unused until this phase's Risk Findings list; AggregateSeverityBrushConverter is
         new, for the app-row/summary-tile severity display (see its own doc comment for why it
         needs a distinct converter from the single-finding one). -->
    <res:RiskSeverityBrushConverter x:Key="RiskSeverityToBrush" />
    <res:AggregateSeverityBrushConverter x:Key="AggregateSeverityToBrush" />
    <res:CountToInverseVisibilityConverter x:Key="CountToInverseVisibility" />

    <!-- GUI-5: Report Export/Viewer visibility converters — see each type's own doc comment. -->
    <res:CountToVisibilityConverter x:Key="CountToVisibility" />
    <res:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

    <!-- Palette -->
    <SolidColorBrush x:Key="App.Background" Color="#FFF5F6F8" />
    <SolidColorBrush x:Key="App.HeaderBackground" Color="#FF1F2933" />
    <SolidColorBrush x:Key="App.NavBackground" Color="#FF273444" />
    <SolidColorBrush x:Key="App.FooterBackground" Color="#FFE4E7EB" />
    <SolidColorBrush x:Key="App.Foreground" Color="#FF1F2933" />
    <SolidColorBrush x:Key="App.ForegroundOnDark" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="App.MutedForeground" Color="#FF7B8794" />
    <SolidColorBrush x:Key="App.AccentBrush" Color="#FF2563EB" />

    <!-- Risk severity visual mapping — see ServerSleuth.Gui.Resources.RiskSeverityBrushConverter.
         Named EXACTLY after ServerSleuth.Analysis.Risk.Models.RiskSeverity's five existing
         members (skill.md GUI-1 §7: "must be based on the existing domain enum... do not
         invent new severity values") — no "None"/sixth value exists here because none exists
         on the real enum. -->
    <SolidColorBrush x:Key="Risk.Info" Color="#FF60A5FA" />
    <SolidColorBrush x:Key="Risk.Low" Color="#FF34D399" />
    <SolidColorBrush x:Key="Risk.Medium" Color="#FFFBBF24" />
    <SolidColorBrush x:Key="Risk.High" Color="#FFF97316" />
    <SolidColorBrush x:Key="Risk.Critical" Color="#FFDC2626" />

    <!-- Spacing conventions -->
    <Thickness x:Key="Spacing.Small">8</Thickness>
    <Thickness x:Key="Spacing.Medium">16</Thickness>
    <Thickness x:Key="Spacing.Large">24</Thickness>

    <!-- Typography defaults -->
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource App.ForegroundOnDark}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.PageTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource App.Foreground}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource App.Foreground}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="Text.Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource App.MutedForeground}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Common button style -->
    <Style x:Key="App.Button" TargetType="Button">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Background" Value="{StaticResource App.AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource App.ForegroundOnDark}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Navigation item style -->
    <Style x:Key="NavigationItem" TargetType="Button">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource App.ForegroundOnDark}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="True">
                <Setter Property="Background" Value="{StaticResource App.AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Status indicator style (idle/running dot, not yet wired to a real scan) -->
    <Style x:Key="StatusIndicator" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Fill" Value="{StaticResource App.MutedForeground}" />
    </Style>

    <!-- GUI-4: a plain card/tile container for the dashboard's summary sections (Scan Summary,
         Risk Summary, Migration Summary, ...) — no third-party layout/chart library, only a
         Border with the existing palette. -->
    <Style x:Key="Dashboard.Card" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource App.MutedForeground}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="{StaticResource Spacing.Medium}" />
        <Setter Property="Margin" Value="0,0,12,12" />
    </Style>

    <Style x:Key="Dashboard.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

</ResourceDictionary>
