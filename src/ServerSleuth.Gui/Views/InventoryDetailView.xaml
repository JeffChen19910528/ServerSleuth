<UserControl x:Class="ServerSleuth.Gui.Views.InventoryDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:evidence="clr-namespace:ServerSleuth.Core.Evidence;assembly=ServerSleuth.Core">

    <!-- GUI-6A: the reusable Discovery Inventory item detail panel. Every value here is a
         direct, one-way read off InventoryDetailViewModel — no calculation, no Execute
         affordance, and nothing beyond what the selected DiscoveryEntity already carries. -->
    <Border Style="{StaticResource Dashboard.Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
            <StackPanel>
                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Type}" />

                <!-- IDENTITY -->
                <WrapPanel Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,20,4">
                        <Run Text="{DynamicResource InventoryDetail.Id}" FontWeight="SemiBold" /><Run Text="{Binding Id, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,20,4">
                        <Run Text="{DynamicResource InventoryDetail.Status}" FontWeight="SemiBold" /><Run Text="{Binding Status, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,20,4">
                        <Run Text="{DynamicResource InventoryDetail.Version}" FontWeight="SemiBold" /><Run Text="{Binding Version, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,20,4">
                        <Run Text="{DynamicResource InventoryDetail.Architecture}" FontWeight="SemiBold" /><Run Text="{Binding Architecture, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,20,4">
                        <Run Text="{DynamicResource InventoryDetail.Publisher}" FontWeight="SemiBold" /><Run Text="{Binding Publisher, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,20,4">
                        <Run Text="{DynamicResource InventoryDetail.Source}" FontWeight="SemiBold" /><Run Text="{Binding Source, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,20,4">
                        <Run Text="{DynamicResource InventoryDetail.Confidence}" FontWeight="SemiBold" /><Run Text="{Binding Confidence, Mode=OneWay}" />
                    </TextBlock>
                </WrapPanel>
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,4,0,0" TextWrapping="Wrap">
                    <Run Text="{DynamicResource InventoryDetail.Path}" FontWeight="SemiBold" /><Run Text="{Binding Path, Mode=OneWay}" />
                </TextBlock>

                <!-- APPLICATIONS — never a single guessed owner: every affected application is
                     listed (skill.md GUI-6A §10). Empty ⇒ "Unassigned", never fabricated. -->
                <TextBlock Text="{DynamicResource InventoryDetail.Applications}" Style="{StaticResource Dashboard.SectionTitle}" Margin="0,16,0,8" />
                <TextBlock Text="{DynamicResource InventoryDetail.Unassigned}" Style="{StaticResource Text.Muted}"
                           Visibility="{Binding HasApplicationAttribution, Converter={StaticResource InverseBoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding AffectedApplications}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding}" Margin="0,2,0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- EVIDENCE — read straight from the entity's own EvidenceRecord list, never
                     re-scanned (skill.md GUI-6A §9). -->
                <TextBlock Text="{DynamicResource InventoryDetail.Evidence}" Style="{StaticResource Dashboard.SectionTitle}" Margin="0,16,0,8" />
                <TextBlock Text="{DynamicResource InventoryDetail.NoEvidence}" Style="{StaticResource Text.Muted}"
                           Visibility="{Binding Evidence.Count, Converter={StaticResource CountToInverseVisibility}}" />
                <ItemsControl ItemsSource="{Binding Evidence}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type evidence:EvidenceRecord}">
                            <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,2,0,2">
                                <Run Text="{Binding Type, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=" — " /><Run Text="{Binding Location, Mode=OneWay}" />
                                <Run Text=" (" /><Run Text="{Binding Detail, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- METADATA — the entity's own already-redacted key/value pairs (every scanner
                     redacts secret-shaped values via ISecretRedactor before a DiscoveryEntity is
                     ever constructed — see InventoryDetailViewModel's own doc comment); this view
                     performs no redaction of its own because none is needed here. -->
                <TextBlock Text="{DynamicResource InventoryDetail.Metadata}" Style="{StaticResource Dashboard.SectionTitle}" Margin="0,16,0,8" />
                <TextBlock Text="{DynamicResource InventoryDetail.NoMetadata}" Style="{StaticResource Text.Muted}"
                           Visibility="{Binding Metadata.Count, Converter={StaticResource CountToInverseVisibility}}" />
                <ItemsControl ItemsSource="{Binding Metadata}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,2,0,2">
                                <Run Text="{Binding Key, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=": " /><Run Text="{Binding Value, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
